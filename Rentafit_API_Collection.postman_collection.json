							"path": ["api", "v1", "rental", "contracts", "byCustomer", "{{customer_id}}"],
							"query": [{"key": "page","value": "0"},{"key": "size","value": "10"}]
						}
					},
					"response": []
				},
				{
					"name": "Create Contract - Valid DRAFT",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set(\"contract_id\", jsonData.id);",
									"    pm.test(\"Contract created as DRAFT\", function () {",
									"        pm.expect(jsonData.status).to.equal(\"DRAFT\");",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type","value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customerId\": \"{{customer_id}}\",\n  \"contractType\": 0,\n  \"createdByEmployeeId\": \"{{employee_id}}\",\n  \"pickupDate\": \"2026-06-05\",\n  \"eventDate\": \"2026-06-07\",\n  \"returnDate\": \"2026-06-09\",\n  \"notes\": \"Contrato de teste\",\n  \"items\": [\n    {\n      \"rentalItemId\": null,\n      \"legacyProductCode\": \"001\",\n      \"description\": \"Vestido de Noiva Branco M\",\n      \"value\": 500.00,\n      \"metadata\": [\n        {\"type\": \"ACESSORIO\", \"description\": \"Véu branco\", \"accessoryId\": null},\n        {\"type\": \"OBSERVACAO\", \"description\": \"Ajuste na cintura necessário\", \"accessoryId\": null}\n      ]\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/rental/contracts",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "rental", "contracts"]
						},
						"description": "Cria proposta (DRAFT). Não reserva itens nem valida conflitos."
					},
					"response": []
				},
				{
					"name": "Update Contract (DRAFT only)",
					"request": {
						"method": "PUT",
						"header": [{"key": "Content-Type","value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"contractType\": 0,\n  \"pickupDate\": \"2026-06-05\",\n  \"eventDate\": \"2026-06-07\",\n  \"returnDate\": \"2026-06-09\",\n  \"notes\": \"Observação atualizada\",\n  \"items\": [\n    {\n      \"legacyProductCode\": \"001\",\n      \"description\": \"Vestido de Noiva Branco M\",\n      \"value\": 550.00,\n      \"metadata\": []\n    }\n  ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/rental/contracts/{{contract_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "rental", "contracts", "{{contract_id}}"]
						},
						"description": "Bloqueado se status != DRAFT. Retorna 422."
					},
					"response": []
				},
				{
					"name": "Sign Contract (DRAFT → SIGNED)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.test(\"Contract status is SIGNED\", function () {",
									"        pm.expect(jsonData.status).to.equal(\"SIGNED\");",
									"    });",
									"    if (jsonData.warnings && jsonData.warnings.length > 0) {",
									"        console.warn(\"Conflict warnings:\", jsonData.warnings);",
