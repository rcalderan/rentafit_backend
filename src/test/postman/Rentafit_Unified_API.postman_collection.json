					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set(\"access_token\", jsonData.accessToken);",
									"    pm.collectionVariables.set(\"refresh_token\", jsonData.refreshToken);",
									"    console.log(\"Access Token salvo: \" + jsonData.accessToken);",
									"    console.log(\"Refresh Token salvo: \" + jsonData.refreshToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
