{
  "info": {
    "name": "NFS-e Billing API",
    "description": "Coleção de requisições para os endpoints de emissão e gestão de NFS-e",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Emitir NFS-e",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{customer_id}}\",\n  \"serviceValue\": 1000.00,\n  \"nbsCode\": \"1.0101\",\n  \"serviceDescription\": \"Serviços de consultoria empresarial e análise de sistemas\",\n  \"cityCode\": \"3550308\",\n  \"ibsRate\": 0.025,\n  \"cbsRate\": 0.015,\n  \"isqnRate\": 0.0\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/billing/invoices/emit",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "billing",
            "invoices",
            "emit"
          ]
        },
        "description": "Emite uma nova NFS-e para um cliente através do Portal Nacional"
      },
      "response": []
    },
    {
      "name": "2. Consultar NFS-e por ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/billing/invoices/{{invoice_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "billing",
            "invoices",
            "{{invoice_id}}"
          ]
        },
        "description": "Busca uma NFS-e no banco de dados local pelo ID interno"
      },
      "response": []
    },
    {
      "name": "3. Consultar NFS-e no Portal (por chave)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/billing/invoices/chave/{{access_key}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "billing",
            "invoices",
            "chave",
            "{{access_key}}"
          ]
        },
        "description": "Consulta os detalhes de uma NFS-e autorizada diretamente no Portal Nacional"
      },
      "response": []
    },
    {
      "name": "4. Download PDF (DANFSe)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/billing/invoices/chave/{{access_key}}/pdf",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "billing",
            "invoices",
            "chave",
            "{{access_key}}",
            "pdf"
          ]
        },
        "description": "Baixa o Documento Auxiliar da NFS-e em formato PDF"
      },
      "response": []
    },
    {
      "name": "5. Download XML Legal",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/billing/invoices/chave/{{access_key}}/xml",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "billing",
            "invoices",
            "chave",
            "{{access_key}}",
            "xml"
          ]
        },
        "description": "Baixa o arquivo XML legal da NFS-e"
      },
      "response": []
    },
    {
      "name": "6. Consultar por Número da Nota",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/billing/invoices/numero/{{invoice_number}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "billing",
            "invoices",
            "numero",
            "{{invoice_number}}"
          ]
        },
        "description": "Busca uma NFS-e no banco de dados local pelo número da nota fiscal"
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "customer_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "invoice_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "access_key",
      "value": "",
      "type": "string"
    },
    {
      "key": "invoice_number",
      "value": "",
      "type": "string"
    }
  ]
}
