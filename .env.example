# Database Configuration
# These environment variables must be set when running the application

DB_HOST=localhost:5433
DB_NAME=retafit
DB_USER=postgres
DB_PASSWORD=1234567

# JWT Secret - OBRIGATORIO. Gere um valor seguro (ex: openssl rand -hex 32)
# ATENÇÃO: nunca use o valor de exemplo em produção!
RENTFIT_JWT_SECRET=troque-por-um-segredo-forte-de-pelo-menos-32-chars

NFSE_API_URL=API_URL
NFSE_CERT_PATH=A1_CERT_PATH
NFSE_CERT_PASSWORD=A1_CERT_PASSWORD

# Truststore dedicado para CAs da SEFAZ/SEFIN (ICP-Brasil)
# Se vazio, usa o cacerts padrão do JDK
# Para gerar: rode SefazCacertsGenerator.gerar("sefaz-cacerts.jks", "changeit")
NFSE_TRUSTSTORE_PATH=
NFSE_TRUSTSTORE_PASSWORD=changeit
