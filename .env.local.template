# docker-compose.local.yaml - Environment Variables
# Copy to .env and fill in values: cp .env.local.template .env

# --- Database (shared Postgres) ---
DB_PASSWORD=1234567

# --- Rentafit JWT ---
RENTFIT_JWT_SECRET=local-dev-secret-change-in-prod-must-be-at-least-32-chars

# --- Costume Rental NFe - Certificado Digital ---
# Diretorio local onde esta o .pfx (montado em /certs no container)
CERT_DIR=./.cert
NFSE_CERT_PATH=/certs/certificate.pfx
NFSE_CERT_PASSWORD=sua_senha_certificado

# --- Costume Rental NFe - Emitente ---
NFE_EMIT_CNPJ=00000000000000
